---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostPlate from '../components/PostPlate.astro';
import { samplePosts, authorProfile, getPostUrl } from '../data/posts';

const recentPosts = samplePosts.slice(0, 4);
---

<BaseLayout
  title="H. Kapginlian | Linguist & Language Researcher"
  description="Personal academic website, fieldwork notes, and linguistic essays by H. Kapginlian."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-12">
    <!-- Split Layout: Desktop 2-column (Left Sticky Bio, Right Feed), Mobile Stacked -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start">
      
      <!-- LEFT COLUMN: Sticky Bio Card & Credentials -->
      <aside class="lg:col-span-4 lg:sticky lg:top-24 space-y-6">
        <div class="bg-[var(--bg-secondary)]/70 border border-[var(--border-color)] rounded-2xl p-6 sm:p-7 shadow-xs">
          <!-- Author Avatar & Name -->
          <div class="flex items-center gap-4 mb-5">
            <img
              src={authorProfile.avatar}
              alt={authorProfile.name}
              class="w-20 h-20 sm:w-22 sm:h-22 rounded-2xl object-cover border-2 border-[var(--border-color)] shadow-sm"
              loading="eager"
            />
            <div>
              <h1 class="text-xl sm:text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)]">
                {authorProfile.name}
              </h1>
              <p class="text-xs sm:text-sm font-sans font-medium text-[var(--accent)] mt-0.5">
                {authorProfile.title}
              </p>
              <p class="text-xs font-mono text-[var(--text-secondary)] mt-0.5">
                📍 {authorProfile.location}
              </p>
            </div>
          </div>

          <!-- Bio text (Exact) -->
          <p class="text-sm font-serif leading-relaxed text-[var(--text-secondary)] mb-5">
            {authorProfile.shortBio}
          </p>

          <!-- Research Focus Tags -->
          <div class="mb-6">
            <h2 class="text-xs font-sans font-semibold uppercase tracking-wider text-[var(--text-secondary)] mb-2.5">
              Primary Research Areas
            </h2>
            <div class="flex flex-wrap gap-1.5 font-sans">
              <span class="px-2.5 py-1 text-xs font-medium rounded-md bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-primary)]">
                Morphology & Syntax
              </span>
              <span class="px-2.5 py-1 text-xs font-medium rounded-md bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-primary)]">
                Indigenous Knowledge Systems
              </span>
              <span class="px-2.5 py-1 text-xs font-medium rounded-md bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-primary)]">
                Language Documentation
              </span>
              <span class="px-2.5 py-1 text-xs font-medium rounded-md bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-primary)]">
                Folklore & Folktales
              </span>
              <span class="px-2.5 py-1 text-xs font-medium rounded-md bg-[var(--bg-primary)] border border-[var(--border-color)] text-[var(--text-primary)]">
                Intangible Cultural Heritage
              </span>
            </div>
          </div>

          <!-- Quick Metrics -->
          <div class="grid grid-cols-2 gap-3 py-3 px-4 rounded-xl bg-[var(--bg-primary)] border border-[var(--border-color)] text-center mb-6">
            <div>
              <span class="block text-base font-bold font-sans text-[var(--text-primary)]">4</span>
              <span class="text-xs text-[var(--text-secondary)]">Research Papers</span>
            </div>
            <div class="border-l border-[var(--border-color)]">
              <span class="block text-base font-bold font-sans text-[var(--text-primary)]">Simte &amp; Kaipeng</span>
              <span class="text-xs text-[var(--text-secondary)]">Primary Languages</span>
            </div>
          </div>

          <!-- Action Buttons (Min 44px height for mobile comfort) -->
          <div class="space-y-2.5 font-sans">
            <a
              href="/about"
              class="w-full min-h-[44px] inline-flex items-center justify-center gap-2 px-4 py-2.5 rounded-xl bg-[var(--text-primary)] text-[var(--bg-primary)] hover:opacity-90 font-medium text-sm transition-opacity"
            >
              <span>Full Biography & Research</span>
              <span>→</span>
            </a>
            <div class="grid grid-cols-2 gap-2">
              <a
                href="/about#publications"
                class="min-h-[44px] inline-flex items-center justify-center px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] hover:bg-[var(--bg-secondary)] text-xs font-medium text-[var(--text-primary)] transition-colors"
              >
                📄 Publications
              </a>
              <a
                href="/socials"
                class="min-h-[44px] inline-flex items-center justify-center px-3 py-2 rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] hover:bg-[var(--bg-secondary)] text-xs font-medium text-[var(--text-primary)] transition-colors"
              >
                🌐 Academic Hub
              </a>
            </div>
          </div>
        </div>

        <!-- Linguistic Feature Showcase Card: Interactive Leipzig Gloss Sample -->
        <div class="bg-[var(--bg-secondary)]/50 border border-[var(--border-color)] rounded-2xl p-5 text-sm">
          <div class="flex items-center justify-between mb-2">
            <span class="text-xs font-sans font-bold uppercase tracking-wider text-[var(--accent)]">
              Morphology Sample (Leipzig Gloss)
            </span>
            <span class="text-xs font-mono text-[var(--text-secondary)]">Simte (smt)</span>
          </div>
          <div class="gloss-block text-xs bg-[var(--bg-primary)] my-0">
            <div class="gloss-words">
              <div class="gloss-word-unit">
                <span class="word-src ipa">kou</span>
                <span class="word-gloss">1PL.EXCL</span>
              </div>
              <div class="gloss-word-unit">
                <span class="word-src ipa">ka</span>
                <span class="word-gloss">1PL.AGR</span>
              </div>
              <div class="gloss-word-unit">
                <span class="word-src ipa">ki-it</span>
                <span class="word-gloss">RECIP-love</span>
              </div>
              <div class="gloss-word-unit">
                <span class="word-src ipa">-uʔ</span>
                <span class="word-gloss">PL</span>
              </div>
            </div>
            <p class="gloss-line-trans text-xs mt-2 text-[var(--text-secondary)]">
              'We love each other.' (Simte Reciprocal / Pro-Drop, Kapginlian 2023)
            </p>
          </div>
        </div>
      </aside>

      <!-- RIGHT COLUMN: Recent Writing & Field Notes Feed -->
      <section class="lg:col-span-8 space-y-8">
        <div class="flex items-baseline justify-between border-b border-[var(--border-color)] pb-3">
          <div>
            <h2 class="text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)]">
              Recent Dispatches
            </h2>
            <p class="text-xs sm:text-sm font-sans text-[var(--text-secondary)] mt-0.5">
              Peer-reviewed papers, oral histories, theological reflections, and cultural dispatches.
            </p>
          </div>
          <a
            href="/feed"
            class="text-xs sm:text-sm font-sans font-medium text-[var(--accent)] hover:underline flex items-center gap-1 min-h-[44px]"
          >
            <span>All Posts</span>
            <span>→</span>
          </a>
        </div>

        <!-- Post Cards List (Wide horizontal layout matching feed) -->
        <div class="space-y-6">
          {recentPosts.map((post) => (
            <article class="group bg-[var(--bg-secondary)]/40 hover:bg-[var(--bg-secondary)]/80 border border-[var(--border-color)] rounded-2xl p-5 sm:p-6 transition-all duration-200">
              <div class="grid grid-cols-1 sm:grid-cols-12 gap-5 sm:gap-6 items-center">
                
                <!-- Text Content (on left, leads the card) -->
                <div class="sm:col-span-7 md:col-span-8 space-y-2.5">
                  <div class="flex flex-wrap items-center gap-2 text-xs font-sans text-[var(--text-secondary)]">
                    <span class="px-2.5 py-0.5 rounded bg-[var(--accent-light)] text-[var(--accent)] font-semibold">
                      {post.category}
                    </span>
                    <span>•</span>
                    <time datetime={post.date}>{post.date}</time>
                    <span>•</span>
                    <span>{post.readingTime}</span>
                  </div>

                  <h3 class="text-lg sm:text-xl font-bold font-sans tracking-tight text-[var(--text-primary)] group-hover:text-[var(--accent)] transition-colors">
                    <a href={getPostUrl(post)}>
                      {post.title}
                    </a>
                  </h3>

                  {post.subtitle && (
                    <p class="text-xs sm:text-sm font-sans text-[var(--text-secondary)] font-medium line-clamp-1">
                      {post.subtitle}
                    </p>
                  )}

                  <p class="text-sm font-serif text-[var(--text-secondary)] leading-relaxed line-clamp-2">
                    {post.excerpt}
                  </p>

                  <!-- Tags -->
                  <div class="flex flex-wrap gap-1.5 pt-1 font-sans">
                    {post.tags.slice(0, 3).map((tag) => (
                      <span class="text-xs font-mono text-[var(--text-secondary)] hover:text-[var(--text-primary)]">
                        #{tag.toLowerCase()}
                      </span>
                    ))}
                  </div>
                </div>

                <!-- Academic Monograph Plate (Clean, uncluttered on Home) -->
                <div class="sm:col-span-5 md:col-span-4">
                  <a href={getPostUrl(post)} class="block group-hover:opacity-95 transition-opacity">
                    <PostPlate post={post} aspect="aspect-video sm:aspect-[4/3]" minimal={true} />
                  </a>
                </div>

              </div>
            </article>
          ))}
        </div>

        <!-- Bottom Feed Navigation CTA -->
        <div class="p-6 rounded-2xl border border-[var(--border-color)] bg-[var(--bg-secondary)]/30 flex flex-col sm:flex-row items-center justify-between gap-4 font-sans text-center sm:text-left">
          <div>
            <h4 class="font-bold text-sm text-[var(--text-primary)]">Looking for specific language tags or topics?</h4>
            <p class="text-xs text-[var(--text-secondary)] mt-0.5">Explore the categorized archive with real-time keyword search.</p>
          </div>
          <div class="flex items-center gap-2">
            <a
              href="/feed"
              class="min-h-[44px] inline-flex items-center px-4 py-2 text-xs font-medium rounded-xl bg-[var(--text-primary)] text-[var(--bg-primary)] hover:opacity-90 transition-opacity"
            >
              Chronological Feed
            </a>
            <a
              href="/archive"
              class="min-h-[44px] inline-flex items-center px-4 py-2 text-xs font-medium rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)] hover:bg-[var(--bg-secondary)] text-[var(--text-primary)] transition-colors"
            >
              Search Archive
            </a>
          </div>
        </div>
      </section>

    </div>
  </div>
</BaseLayout>
