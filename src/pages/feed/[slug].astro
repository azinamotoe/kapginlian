---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { samplePosts, type Post } from '../../data/posts';

export function getStaticPaths() {
  return samplePosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;

// Find next and prev posts
const currentIndex = samplePosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex > 0 ? samplePosts[currentIndex - 1] : null;
const nextPost = currentIndex < samplePosts.length - 1 ? samplePosts[currentIndex + 1] : null;
const isAcademic = post.postType === "academic_paper";
---

<BaseLayout
  title={`${post.title} | H. Kapginlian`}
  description={post.excerpt}
  ogImage={post.coverImage}
>
  <article class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumb & Back navigation -->
    <nav class="flex items-center justify-between text-xs font-sans text-[var(--text-secondary)] mb-8">
      <div class="flex items-center gap-2">
        <a href="/feed" class="hover:text-[var(--accent)] transition-colors min-h-[44px] inline-flex items-center font-medium">
          ← Back to Feed
        </a>
        <span>/</span>
        <span class="text-[var(--accent)] font-medium">{post.category}</span>
      </div>

      {isAcademic && (
        <span class="px-2.5 py-1 rounded-full bg-[var(--bg-secondary)] border border-[var(--border-color)] font-mono text-[11px] text-[var(--accent)] font-semibold uppercase tracking-wider">
          📄 Peer-Reviewed Paper
        </span>
      )}
    </nav>

    <!-- POST HEADER -->
    <header class="border-b border-[var(--border-color)] pb-8 mb-8 space-y-4">
      {isAcademic && post.journal && (
        <div class="p-3.5 rounded-xl bg-[var(--bg-secondary)] border border-[var(--border-color)] flex flex-col sm:flex-row sm:items-center justify-between gap-2 text-xs font-sans">
          <div class="space-y-0.5">
            <span class="font-bold text-[var(--text-primary)] block sm:inline">{post.journal}</span>
            {post.volume && <span class="text-[var(--text-secondary)] font-serif italic sm:ml-2">• {post.volume}</span>}
            {post.issn && <span class="text-[var(--text-secondary)] font-mono sm:ml-2">• ISSN: {post.issn}</span>}
          </div>
          {post.doi && (
            <a href={`https://doi.org/${post.doi}`} target="_blank" rel="noopener noreferrer" class="text-[var(--accent)] font-mono hover:underline shrink-0">
              DOI: {post.doi} ↗
            </a>
          )}
        </div>
      )}

      <!-- Category & Date pills -->
      <div class="flex flex-wrap items-center gap-2.5 text-xs font-sans text-[var(--text-secondary)]">
        <span class="px-2.5 py-1 rounded-md bg-[var(--accent-light)] text-[var(--accent)] font-semibold">
          {post.category}
        </span>
        <span>•</span>
        <time datetime={post.date}>{post.date}</time>
        <span>•</span>
        <span>{post.readingTime}</span>
        {post.language && (
          <>
            <span>•</span>
            <span class="font-mono bg-[var(--bg-secondary)] px-2 py-0.5 rounded text-[11px] text-[var(--text-primary)] font-medium">
              Language: {post.language}
            </span>
          </>
        )}
      </div>

      <!-- Main Title -->
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-sans tracking-tight text-[var(--text-primary)] leading-tight">
        {post.title}
      </h1>

      {post.subtitle && (
        <p class="text-lg sm:text-xl font-serif italic text-[var(--text-secondary)] leading-relaxed">
          {post.subtitle}
        </p>
      )}

      <!-- Author Line -->
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-4 pt-3 font-sans border-t border-[var(--border-color)]/60">
        <div class="flex items-center gap-3">
          <img
            src="/images/author-avatar.jpg"
            alt="H. Kapginlian"
            class="w-12 h-12 rounded-full object-cover border border-[var(--border-color)] shadow-xs"
          />
          <div>
            <span class="block text-sm font-bold text-[var(--text-primary)]">
              {post.authors || "H. Kapginlian"}
            </span>
            <span class="block text-xs text-[var(--text-secondary)]">
              North-Eastern Hill University (NEHU), Shillong
            </span>
          </div>
        </div>

        {/* PDF Download Button for Academic Papers */}
        {post.pdfUrl && (
          <div class="flex items-center gap-2">
            <a
              href={post.pdfUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="min-h-[44px] px-4 py-2.5 rounded-xl bg-[var(--text-primary)] text-[var(--bg-primary)] font-bold text-xs hover:opacity-90 transition-opacity inline-flex items-center gap-2 shadow-xs"
            >
              <span>📥 Download Published PDF</span>
            </a>
          </div>
        )}
      </div>
    </header>

    <!-- BOXED ACADEMIC ABSTRACT (If Academic Paper) -->
    {post.abstract && (
      <div class="my-8 p-6 rounded-2xl bg-[var(--bg-secondary)] border border-[var(--border-color)] space-y-3 font-sans">
        <div class="flex items-center justify-between">
          <h2 class="text-xs font-bold uppercase tracking-wider text-[var(--accent)] font-mono">
            Abstract
          </h2>
          <span class="text-[11px] font-mono text-[var(--text-secondary)]">Official Publication Summary</span>
        </div>
        <p class="text-sm font-serif leading-relaxed text-[var(--text-primary)]">
          {post.abstract}
        </p>
        {post.keywords && post.keywords.length > 0 && (
          <div class="pt-2 flex flex-wrap items-center gap-1.5 text-xs text-[var(--text-secondary)]">
            <span class="font-semibold font-mono uppercase text-[11px]">Keywords:</span>
            {post.keywords.map((kw) => (
              <span class="px-2 py-0.5 rounded bg-[var(--bg-primary)] border border-[var(--border-color)] font-mono text-[11px]">
                {kw}
              </span>
            ))}
          </div>
        )}
      </div>
    )}

    <!-- ARTICLE BODY SECTIONS (Extracted Directly from Papers) -->
    <div class="prose prose-stone dark:prose-invert max-w-none text-base sm:text-lg font-serif leading-relaxed text-[var(--text-primary)] space-y-8">
      {post.sections && post.sections.map((sec) => (
        <section class="space-y-4 not-prose">
          <h2 class="text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)] pt-4 border-b border-[var(--border-color)] pb-2">
            {sec.heading}
          </h2>

          {sec.paragraphs && sec.paragraphs.map((p) => (
            <p class="text-base sm:text-lg font-serif leading-relaxed text-[var(--text-primary)]">
              {p}
            </p>
          ))}

          {/* Styled Scholarly Blockquote / Oral History Quote */}
          {sec.blockquote && (
            <figure class="my-6 pl-4 border-l-4 border-[var(--accent)] italic text-[var(--text-primary)] font-serif bg-[var(--bg-secondary)]/50 p-4 rounded-r-xl">
              <p class="text-base sm:text-lg mb-2">"{sec.blockquote.text}"</p>
              {sec.blockquote.source && (
                <figcaption class="text-xs font-sans not-italic text-[var(--text-secondary)] font-medium">
                  — {sec.blockquote.source}
                </figcaption>
              )}
            </figure>
          )}

          {/* Formatted Linguistic Table (e.g. Pronoun paradigm or Numeral comparison) */}
          {sec.table && (
            <div class="my-6 overflow-x-auto rounded-xl border border-[var(--border-color)] bg-[var(--bg-primary)]">
              {sec.table.caption && (
                <div class="py-2.5 px-4 bg-[var(--bg-secondary)] border-b border-[var(--border-color)] text-xs font-mono font-semibold text-[var(--text-primary)]">
                  {sec.table.caption}
                </div>
              )}
              <table class="w-full text-left text-sm font-sans">
                <thead class="bg-[var(--bg-secondary)]/50 border-b border-[var(--border-color)] text-xs uppercase font-semibold text-[var(--text-secondary)]">
                  <tr>
                    {sec.table.headers.map((h) => (
                      <th class="py-2.5 px-4">{h}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-[var(--border-color)]">
                  {sec.table.rows.map((row) => (
                    <tr class="hover:bg-[var(--bg-secondary)]/30 transition-colors">
                      {row.map((cell, idx) => (
                        <td class={`py-2.5 px-4 ${idx === 0 ? "font-bold text-[var(--text-primary)]" : "text-[var(--text-secondary)]"}`}>
                          <span class="ipa">{cell}</span>
                        </td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          )}

          {/* Formatted Leipzig Gloss Examples */}
          {sec.glossExamples && sec.glossExamples.map((ex) => (
            <div class="gloss-block text-sm my-5">
              <div class="text-xs font-mono text-[var(--accent)] uppercase tracking-wider mb-2 font-bold">
                {ex.label}
              </div>
              <div class="gloss-words">
                {ex.words.map((w) => (
                  <div class="gloss-word-unit">
                    <span class="word-src ipa">{w.src}</span>
                    <span class="word-gloss">{w.gloss}</span>
                  </div>
                ))}
              </div>
              <p class="gloss-line-trans text-sm pt-2 mt-2 border-t border-[var(--border-color)]">
                {ex.trans}
              </p>
            </div>
          ))}
        </section>
      ))}
    </div>

    <!-- REFERENCES & BIBLIOGRAPHY (Extracted from Paper) -->
    {post.references && post.references.length > 0 && (
      <footer class="mt-14 pt-8 border-t border-[var(--border-color)] space-y-4">
        <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--text-secondary)] font-mono">
          References & Cited Sources
        </h3>
        <ul class="text-xs font-serif space-y-2 text-[var(--text-secondary)] leading-relaxed">
          {post.references.map((ref) => (
            <li class="pl-4 -indent-4">• {ref}</li>
          ))}
        </ul>
      </footer>
    )}

    <!-- ARTICLE FOOTER: Tags & Post Navigation -->
    <footer class="mt-10 pt-6 border-t border-[var(--border-color)] space-y-6 font-sans">
      <div class="flex flex-wrap items-center gap-2">
        <span class="text-xs font-semibold text-[var(--text-secondary)]">Filed under:</span>
        {post.tags.map((tag) => (
          <a
            href={`/archive?q=${encodeURIComponent(tag)}`}
            class="px-2.5 py-1 text-xs rounded-md bg-[var(--bg-secondary)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>

      <!-- Prev / Next Navigation -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-4 border-t border-[var(--border-color)]">
        {prevPost ? (
          <a
            href={`/feed/${prevPost.slug}`}
            class="p-4 rounded-xl border border-[var(--border-color)] hover:bg-[var(--bg-secondary)] transition-colors space-y-1 min-h-[44px]"
          >
            <span class="text-xs text-[var(--text-secondary)] block">← Previous Paper / Dispatch</span>
            <span class="text-sm font-bold text-[var(--text-primary)] line-clamp-1">{prevPost.title}</span>
          </a>
        ) : <div />}

        {nextPost && (
          <a
            href={`/feed/${nextPost.slug}`}
            class="p-4 rounded-xl border border-[var(--border-color)] hover:bg-[var(--bg-secondary)] transition-colors space-y-1 text-right min-h-[44px]"
          >
            <span class="text-xs text-[var(--text-secondary)] block">Next Paper / Dispatch →</span>
            <span class="text-sm font-bold text-[var(--text-primary)] line-clamp-1">{nextPost.title}</span>
          </a>
        )}
      </div>
    </footer>
  </article>
</BaseLayout>
