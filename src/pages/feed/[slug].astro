---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { samplePosts, type Post } from '../../data/posts';

export function getStaticPaths() {
  return samplePosts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}

interface Props {
  post: Post;
}

const { post } = Astro.props;

// Find next and prev posts
const currentIndex = samplePosts.findIndex((p) => p.slug === post.slug);
const prevPost = currentIndex > 0 ? samplePosts[currentIndex - 1] : null;
const nextPost = currentIndex < samplePosts.length - 1 ? samplePosts[currentIndex + 1] : null;
---

<BaseLayout
  title={`${post.title} | H. Kapginlian`}
  description={post.excerpt}
  ogImage={post.coverImage}
>
  <article class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-16">
    <!-- Breadcrumb -->
    <nav class="flex items-center gap-2 text-xs font-sans text-[var(--text-secondary)] mb-6">
      <a href="/feed" class="hover:text-[var(--accent)] transition-colors min-h-[44px] inline-flex items-center">← Back to Feed</a>
      <span>/</span>
      <span class="text-[var(--accent)] font-medium">{post.category}</span>
    </nav>

    <!-- Post Header -->
    <header class="border-b border-[var(--border-color)] pb-8 mb-8 space-y-4">
      <div class="flex flex-wrap items-center gap-2.5 text-xs font-sans text-[var(--text-secondary)]">
        <span class="px-2.5 py-1 rounded-md bg-[var(--accent-light)] text-[var(--accent)] font-semibold">
          {post.category}
        </span>
        <span>•</span>
        <time datetime={post.date}>{post.date}</time>
        <span>•</span>
        <span>{post.readingTime}</span>
        {post.language && (
          <>
            <span>•</span>
            <span class="font-mono bg-[var(--bg-secondary)] px-2 py-0.5 rounded text-[11px] text-[var(--text-primary)]">
              {post.language}
            </span>
          </>
        )}
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-bold font-sans tracking-tight text-[var(--text-primary)] leading-tight">
        {post.title}
      </h1>

      {post.subtitle && (
        <p class="text-lg sm:text-xl font-serif italic text-[var(--text-secondary)] leading-relaxed">
          {post.subtitle}
        </p>
      )}

      <!-- Author Byline -->
      <div class="flex items-center gap-3 pt-2 font-sans">
        <img
          src="/images/author.jpg"
          alt="H. Kapginlian"
          class="w-11 h-11 rounded-full object-cover border border-[var(--border-color)] shadow-xs"
        />
        <div>
          <span class="block text-sm font-bold text-[var(--text-primary)]">H. Kapginlian</span>
          <span class="block text-xs text-[var(--text-secondary)]">Linguistics Research Dispatch</span>
        </div>
      </div>
    </header>

    <!-- Featured Cover Image -->
    <div class="mb-10 overflow-hidden rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] aspect-video">
      <img
        src={post.coverImage}
        alt={post.title}
        class="w-full h-full object-cover"
      />
    </div>

    <!-- Article Body with Linguistic Typography -->
    <div class="prose prose-stone dark:prose-invert max-w-none text-base sm:text-lg font-serif leading-relaxed text-[var(--text-primary)] space-y-6">
      
      <p class="text-xl leading-relaxed font-serif text-[var(--text-primary)] font-normal border-l-2 border-[var(--accent)] pl-4 italic">
        {post.excerpt}
      </p>

      <h2 class="text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)] pt-4">
        1. Phonological & Morphosyntactic Context
      </h2>
      <p>
        In contemporary field documentation across Kuki-Chin language varieties, tonal contrasts frequently interact with syllable structure in unexpected ways. Consider the alternation between open syllables carrying falling pitch <span class="ipa font-bold">/âː⁵³/</span> and closed syllables characterized by glottal closure <span class="ipa font-bold">/aʔ²¹/</span>.
      </p>

      <!-- Leipzig Interlinear Gloss Component -->
      <div class="gloss-block not-prose my-6 font-sans">
        <div class="text-xs font-mono text-[var(--text-secondary)] uppercase tracking-wider mb-2 flex justify-between">
          <span>Example (1) — Morphological Case Marking</span>
          <span>Leipzig 3-Line Standard</span>
        </div>
        
        <div class="gloss-words">
          <div class="gloss-word-unit">
            <span class="word-src ipa">khuol-zin-te</span>
            <span class="word-gloss">guest-PL</span>
          </div>
          <div class="gloss-word-unit">
            <span class="word-src ipa">in</span>
            <span class="word-gloss">ERG</span>
          </div>
          <div class="gloss-word-unit">
            <span class="word-src ipa">an-kuong</span>
            <span class="word-gloss">meal-tray</span>
          </div>
          <div class="gloss-word-unit">
            <span class="word-src ipa">a-ne-khawm-uʔ</span>
            <span class="word-gloss">3PL.NOM-eat-together-PL.PST</span>
          </div>
        </div>
        
        <p class="gloss-line-trans text-sm text-[var(--text-secondary)] border-t border-[var(--border-color)] pt-2 mt-2 font-serif">
          'The guests shared a meal together.'
        </p>
      </div>

      <p>
        Notice the verbal complex in Example (1): the agent clitic <span class="ipa font-mono">in</span> marks ergative alignment on the plural subject, while the verb root incorporates the associative collective marker <span class="ipa">-khawm</span> before receiving tense and plural agreement.
      </p>

      <!-- Fieldwork Audio Recording Player Box -->
      <div class="not-prose my-8 p-5 rounded-xl border border-[var(--border-color)] bg-[var(--bg-secondary)] space-y-3 font-sans">
        <div class="flex items-center justify-between">
          <div class="flex items-center gap-2.5">
            <span class="text-xl">🎙️</span>
            <div>
              <h3 class="text-sm font-bold text-[var(--text-primary)]">Audio Elicitation Clip (Field Recording #2026-F14)</h3>
              <p class="text-xs text-[var(--text-secondary)] font-mono">Sampling: 48kHz 24-bit WAV • Speaker: Native Consultant (62 yrs)</p>
            </div>
          </div>
          <span class="px-2 py-0.5 rounded text-[11px] font-mono bg-[var(--accent-light)] text-[var(--accent)] font-semibold">
            Archival Audio
          </span>
        </div>

        <audio controls class="w-full h-9 rounded-lg">
          <source src="#" type="audio/mpeg" />
          Your browser does not support the audio element.
        </audio>

        <p class="text-xs font-serif text-[var(--text-secondary)] italic">
          Phonetic pitch contour illustrates the sudden F0 drop prior to the syllable-final glottal closure.
        </p>
      </div>

      <h2 class="text-2xl font-bold font-sans tracking-tight text-[var(--text-primary)] pt-4">
        2. Working Hypotheses & Theoretical Implications
      </h2>
      <p>
        The historical pathway documented here demonstrates that conservative varieties retain consonantal codas which induce register distinction, whereas innovated dialects collapse coda codings into distinct lexical tone melodies. This supports Haudricourt's classical model of tonogenesis, while introducing new nuances regarding split verb-stem licensing.
      </p>

      <!-- Numbered Linguistic Example (2) -->
      <div class="p-4 rounded-lg bg-[var(--bg-secondary)]/50 border-l-4 border-[var(--accent)] not-prose my-6 font-sans text-sm space-y-1">
        <div class="font-bold text-[var(--text-primary)]">(2) Stem I vs. Stem II Ablaut Pattern:</div>
        <div class="grid grid-cols-3 gap-2 font-mono text-xs pt-1">
          <div><strong class="text-[var(--text-secondary)]">Root:</strong> /hmu/ 'see'</div>
          <div><strong class="text-[var(--text-secondary)]">Stem I:</strong> <span class="ipa">hmuː</span> (declarative)</div>
          <div><strong class="text-[var(--text-secondary)]">Stem II:</strong> <span class="ipa">hmuʔ</span> (subordinate / nominal)</div>
        </div>
      </div>

      <p>
        Further acoustic measurements and f0 trajectory tracking will be published in the accompanying corpus repository.
      </p>
    </div>

    <!-- References & Footnotes -->
    <footer class="mt-12 pt-8 border-t border-[var(--border-color)] space-y-6">
      <div class="space-y-3 font-sans">
        <h3 class="text-sm font-bold uppercase tracking-wider text-[var(--text-secondary)]">
          Selected References
        </h3>
        <ul class="text-xs font-serif space-y-2 text-[var(--text-secondary)]">
          <li>• Comrie, Bernard, Martin Haspelmath & Balthasar Bickel. 2008. <em>The Leipzig Glossing Rules: Conventions for interlinear morpheme-by-morpheme glosses</em>. Max Planck Institute for Evolutionary Anthropology.</li>
          <li>• Matisoff, James A. 1973. <em>Tonogenesis in Southeast Asia</em>. Consonant Types and Tone, pp. 71–95.</li>
          <li>• Peterson, David A. 2003. <em>Hakha Lai</em>. The Sino-Tibetan Languages, Routledge.</li>
        </ul>
      </div>

      <!-- Post Tags -->
      <div class="pt-4 flex flex-wrap items-center gap-2 font-sans">
        <span class="text-xs font-semibold text-[var(--text-secondary)]">Filed under:</span>
        {post.tags.map((tag) => (
          <a
            href={`/archive?q=${encodeURIComponent(tag)}`}
            class="px-2.5 py-1 text-xs rounded-md bg-[var(--bg-secondary)] border border-[var(--border-color)] text-[var(--text-secondary)] hover:text-[var(--text-primary)] transition-colors"
          >
            #{tag}
          </a>
        ))}
      </div>

      <!-- Next & Previous Navigation -->
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 pt-6 border-t border-[var(--border-color)] font-sans">
        {prevPost ? (
          <a
            href={`/feed/${prevPost.slug}`}
            class="p-4 rounded-xl border border-[var(--border-color)] hover:bg-[var(--bg-secondary)] transition-colors space-y-1"
          >
            <span class="text-xs text-[var(--text-secondary)] block">← Previous Dispatch</span>
            <span class="text-sm font-bold text-[var(--text-primary)] line-clamp-1">{prevPost.title}</span>
          </a>
        ) : <div />}

        {nextPost && (
          <a
            href={`/feed/${nextPost.slug}`}
            class="p-4 rounded-xl border border-[var(--border-color)] hover:bg-[var(--bg-secondary)] transition-colors space-y-1 text-right"
          >
            <span class="text-xs text-[var(--text-secondary)] block">Next Dispatch →</span>
            <span class="text-sm font-bold text-[var(--text-primary)] line-clamp-1">{nextPost.title}</span>
          </a>
        )}
      </div>
    </footer>
  </article>
</BaseLayout>
