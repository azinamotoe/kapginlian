---
import { url } from '../utils/url';
import SocialIcon from './SocialIcon.astro';
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[var(--border-color)] bg-[var(--bg-secondary)]/50 py-12 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 mb-8 font-sans">
      <!-- Col 1: Scholar Bio -->
      <div class="md:col-span-5 space-y-3">
        <h3 class="text-base font-bold text-[var(--text-primary)]">H. Kapginlian</h3>
        <p class="text-xs sm:text-sm text-[var(--text-secondary)] font-serif leading-relaxed">
          Linguist specializing in Tibeto-Burman &amp; Kuki-Chin morphology and syntax, Indigenous Knowledge Systems, and intangible cultural heritage documentation. Completed PhD in Linguistics from NEHU, Shillong.
        </p>
        <p class="text-xs font-mono text-[var(--text-secondary)]">
          Documented: Simte (<span class="text-[var(--accent)] font-semibold">smt</span>) &bull; Kaipeng (<span class="text-[var(--accent)] font-semibold">kzp</span>)
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="md:col-span-4 space-y-2">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-secondary)]">Navigation</h4>
        <ul class="text-xs sm:text-sm space-y-1.5 font-sans">
          <li><a href={url("/")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Home</a></li>
          <li><a href={url("/research")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Research Publications</a></li>
          <li><a href={url("/feed")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Writing &amp; Dispatches</a></li>
          <li><a href={url("/poems")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Poems &amp; Oral Verse</a></li>
          <li><a href={url("/archive")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Writing Archive &amp; Search</a></li>
          <li><a href={url("/about")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Curriculum &amp; Biography</a></li>
          <li><a href={url("/socials")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Academic Hub &amp; Socials</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Citations -->
      <div class="md:col-span-3 space-y-2">
        <h4 class="text-xs font-mono font-bold uppercase tracking-wider text-[var(--text-secondary)]">Archive &amp; Legal</h4>
        <ul class="text-xs sm:text-sm space-y-1.5 font-sans">
          <li>
            <a href="https://orcid.org/0009-0008-9045-3527" target="_blank" rel="noopener noreferrer" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-flex items-center gap-1.5">
              <span>ORCID Registry</span>
              <SocialIcon name="external" class="w-3 h-3 opacity-70" />
            </a>
          </li>
          <li><a href={url("/terms")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Terms &amp; Citation Use</a></li>
          <li><a href={url("/privacy")} class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors py-0.5 inline-block">Privacy Policy</a></li>
        </ul>
      </div>
    </div>

    <div class="pt-6 border-t border-[var(--border-color)] flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--text-secondary)] font-sans gap-3">
      <p>&copy; {currentYear} H. Kapginlian. All rights reserved.</p>
      <p class="flex items-center gap-4">
        <span>ISO 639-3 Documentation Standards</span>
        <span>&bull;</span>
        <a href="#top" class="hover:text-[var(--text-primary)] transition-colors">Back to top &uarr;</a>
      </p>
    </div>
  </div>
</footer>
