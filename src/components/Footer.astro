---
const currentYear = new Date().getFullYear();
---

<footer class="mt-20 border-t border-[var(--border-color)] bg-[var(--bg-secondary)]/50 py-12 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8 mb-8 font-sans">
      <!-- Col 1: Scholar Bio -->
      <div class="md:col-span-2 space-y-3">
        <h3 class="text-base font-bold text-[var(--text-primary)]">H. Kapginlian Hangluah</h3>
        <p class="text-sm text-[var(--text-secondary)] max-w-md font-serif leading-relaxed">
          Linguist specializing in Tibeto-Burman & Kuki-Chin language documentation, tonogenesis, and morphological typology. All field materials and analyses are shared for research and community revitalization.
        </p>
        <p class="text-xs text-[var(--text-secondary)]">
          Fonts powered by Charis SIL & Newsreader for academic phonetic accuracy.
        </p>
      </div>

      <!-- Col 2: Navigation -->
      <div class="space-y-2">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">Index</h4>
        <ul class="text-sm space-y-1.5">
          <li><a href="/" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Home (Split View)</a></li>
          <li><a href="/feed" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Chronological Feed</a></li>
          <li><a href="/archive" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Archive & Search</a></li>
          <li><a href="/about" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Research & About</a></li>
          <li><a href="/socials" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Social & Academic Hub</a></li>
        </ul>
      </div>

      <!-- Col 3: Legal & Meta -->
      <div class="space-y-2">
        <h4 class="text-xs font-semibold uppercase tracking-wider text-[var(--text-secondary)]">Colophon & Legal</h4>
        <ul class="text-sm space-y-1.5">
          <li><a href="/privacy" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Privacy Policy</a></li>
          <li><a href="/terms" class="text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">Terms & Citation Use</a></li>
          <li>
            <a href="/socials#rss" class="inline-flex items-center gap-1 text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors">
              <span class="text-xs">📡</span> RSS Feed
            </a>
          </li>
          <li>
            <span class="inline-block text-xs font-mono text-[var(--text-secondary)] mt-2">
              Static build via Astro
            </span>
          </li>
        </ul>
      </div>
    </div>

    <div class="pt-8 border-t border-[var(--border-color)] flex flex-col sm:flex-row items-center justify-between text-xs text-[var(--text-secondary)] font-sans gap-4">
      <p>© {currentYear} H. Kapginlian Hangluah. All rights reserved.</p>
      <p class="flex items-center gap-4">
        <span>ISO 639-3 Research Archiving</span>
        <span>•</span>
        <a href="#top" class="hover:text-[var(--text-primary)] transition-colors">Back to top ↑</a>
      </p>
    </div>
  </div>
</footer>
